<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: no se respalda ni se transfiere nada. La app solo guarda una caché del
    contenido de la API, que se vuelve a descargar sola en el nuevo teléfono.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

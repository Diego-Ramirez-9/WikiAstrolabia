<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 a 11: no se respalda nada (equivalente a data_extraction_rules.xml para Android 12+).
    La app solo guarda una caché del contenido de la API.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
